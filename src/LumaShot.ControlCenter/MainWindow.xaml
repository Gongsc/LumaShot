<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LumaShot_ControlCenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LumaShot_ControlCenter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LumaShot"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="48"
            Padding="14,0,148,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                Width="22"
                Height="22"
                VerticalAlignment="Center"
                Source="Assets/LumaShot.png" />
            <TextBlock
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="LumaShot" />
            <Border
                Grid.Column="2"
                Margin="12,0,0,0"
                Padding="8,3"
                VerticalAlignment="Center"
                Background="{ThemeResource CaptureModeSelectedBackgroundBrush}"
                BorderBrush="{ThemeResource CaptureModeSelectedBorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="HDR 支持" />
            </Border>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
